;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PikeConsole"
config/version="TechDemo"
run/main_scene="uid://dkhs77u4uksba"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PikeConsole="*uid://dx4bwtrbok1yg"

[dotnet]

project/assembly_name="PikeConsole"

[editor_plugins]

enabled=PackedStringArray("res://addons/PikeConsole/plugin.cfg")

[fractal_pike]

pike_console/config/use_user_configs=true
pike_console/runtime/frontend_scene="uid://bejwps7jfkded"

